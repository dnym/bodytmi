  "blueprints": [
    {
      "id": "olympic-barbell",
      "name": "Olympic barbell with plates",
      "notes": "Two sleeves loaded symmetrically. Fill in your gym, the bar's own mass and the plates you have.",
      "choices": [
        {
          "id": "gym",
          "kind": "gym",
          "label": "Gym"
        },
        {
          "id": "bar-mass",
          "kind": "quantity",
          "label": "Bar mass",
          "dimension": "mass",
          "minimum": {
            "value": "5",
            "unit": "kg"
          },
          "default": {
            "value": "20",
            "unit": "kg"
          }
        },
        {
          "id": "plates",
          "kind": "plates",
          "label": "Plates (total count per denomination)"
        }
      ],
      "instances": {
        "bar": {
          "equipmentId": "barbell",
          "gym": {
            "$choice": "gym"
          },
          "name": "Olympic barbell",
          "loading": {
            "components": [
              {
                "id": "bar",
                "kind": "bar",
                "mass": {
                  "$choice": "bar-mass"
                }
              }
            ],
            "channel": {
              "id": "sleeves",
              "sides": 2,
              "symmetry": "required"
            },
            "plates": {
              "$choice": "plates"
            }
          }
        }
      }
    },
    {
      "id": "selectorized-machine",
      "name": "Selectorized machine",
      "notes": "A weight stack with evenly spaced pin positions. Fill in which machine, your gym, the first marked weight, the step between pins and the number of pins.",
      "choices": [
        {
          "id": "machine",
          "kind": "equipment",
          "label": "Which machine"
        },
        {
          "id": "gym",
          "kind": "gym",
          "label": "Gym"
        },
        {
          "id": "first",
          "kind": "quantity",
          "label": "First marked weight",
          "dimension": "mass"
        },
        {
          "id": "step",
          "kind": "number",
          "label": "Step between pins, in the same unit",
          "minimum": "0.5"
        },
        {
          "id": "pins",
          "kind": "integer",
          "label": "Number of pin positions",
          "minimum": 1,
          "maximum": 1000
        }
      ],
      "instances": {
        "stack": {
          "equipmentId": {
            "$choice": "machine"
          },
          "gym": {
            "$choice": "gym"
          },
          "scale": {
            "id": "stack",
            "unit": {
              "$unit": "first"
            },
            "range": {
              "start": {
                "$value": "first"
              },
              "step": {
                "$choice": "step"
              },
              "count": {
                "$choice": "pins"
              }
            }
          }
        }
      }
    }
